name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'Agent Name'
        required: true
        default: 'yeahgyrist'
      agent_description:
        description: 'Agent Description'
        required: true
        default: 'yeahgyrist AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity

      # === DEBUG BARU (ini yang penting) ===
      - name: Debug - Cek folder setelah install
        run: |
          echo "=== Isi root folder ==="
          ls -la
          echo "=== Folder skills? ==="
          ls -la skills/ || echo "Folder skills TIDAK ADA!"
          echo "=== Semua folder scripts di repo ==="
          find . -name "scripts" -type d

      - name: Install script dependencies
        run: |
          cd skills/verified-agent-identity/scripts
          npm install

      - name: Create new Ethereum Identity
        run: node skills/verified-agent-identity/scripts/createNewEthereumIdentity.js

      - name: Link Human to Agent
        run: |
          node skills/verified-agent-identity/scripts/manualLinkHumanToAgent.js \
            --challenge '{"name": "${{ inputs.agent_name }}", "description": "${{ inputs.agent_description }}"}'
