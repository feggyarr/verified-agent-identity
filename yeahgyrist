name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'Agent Name'
        required: true
        default: 'yeahgyrist'
      agent_description:
        description: 'Agent Description'
        required: true
        default: 'yeahgyrist AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true   # Hilangkan warning Node.js

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Cleanup folder lama
        run: rm -rf verified-agent-identity scripts skills

      - name: Clone skill repo (bypass rate limit)
        run: git clone https://github.com/BillionsNetwork/verified-agent-identity.git verified-agent-identity

      - name: Debug - Cek folder & file
        run: |
          echo "=== Isi folder skill ==="
          ls -la verified-agent-identity/
          echo "=== Folder scripts ==="
          ls -la verified-agent-identity/scripts/

      - name: Install dependencies
        run: |
          cd verified-agent-identity
          npm install
          npm install ethers @0xpolygonid/js-sdk @iden3/js-iden3-auth uuid cross-fetch shell-quote --save

      - name: Create new Ethereum Identity
        run: cd verified-agent-identity && node scripts/createNewEthereumIdentity.js

      - name: Link Human to Agent
        run: |
          cd verified-agent-identity && \
          node scripts/manualLinkHumanToAgent.js \
            --challenge '{"name": "${{ inputs.agent_name }}", "description": "${{ inputs.agent_description }}"}'
