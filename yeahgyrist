name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'Agent Name'
        required: true
        default: 'yeahgyrist'
      agent_description:
        description: 'Agent Description'
        required: true
        default: 'yeahgyrist AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Cleanup folder lama
        run: rm -rf verified-skill

      - name: Clone skill repo (nama unik biar no nesting)
        run: git clone https://github.com/BillionsNetwork/verified-agent-identity.git verified-skill

      - name: Debug - Cek struktur folder
        run: |
          echo "=== Isi skill folder ==="
          ls -la verified-skill/
          echo "=== Isi scripts folder (harus ada package.json) ==="
          ls -la verified-skill/scripts/

      - name: Install dependencies
        run: |
          cd verified-skill/scripts
          npm install
          npm install ethers @0xpolygonid/js-sdk @iden3/js-iden3-auth uuid cross-fetch shell-quote --save

      - name: Create new Ethereum Identity
        run: cd verified-skill/scripts && node createNewEthereumIdentity.js

      - name: Link Human to Agent
        run: |
          cd verified-skill/scripts && \
          node manualLinkHumanToAgent.js \
            --challenge '{"name": "${{ inputs.agent_name }}", "description": "${{ inputs.agent_description }}"}'
